# Provider: openai (original lab baseline) or gemini (free-tier alternative).
AI_PROVIDER=openai

# OpenAI baseline.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini alternative through the official OpenAI-compatible endpoint.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
